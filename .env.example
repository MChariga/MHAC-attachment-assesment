# Copy this file to ".env" and fill it in. Never commit ".env".

# KoboToolbox server: https://kf.kobotoolbox.org (global) or https://eu.kobotoolbox.org (EU) or your own server
KOBO_URL=https://your-kobo-server-url

# Login (HTTP basic auth)
KOBO_USERNAME=your-kobo-username
KOBO_PASSWORD=your-kobo-password

# OR use an API token instead of username/password (Account Settings > Security > API key)
# KOBO_API_TOKEN=your-api-token

# Which form to read. Leave KOBO_ASSET_UID empty to auto-pick the most recently deployed
# form whose name contains KOBO_FORM_NAME.
KOBO_ASSET_UID=
KOBO_FORM_NAME=Attachment Assessment Tool

# false = all submissions of the latest deployed form (default)
# true  = only submissions made with the latest deployed version
KOBO_ONLY_LATEST_VERSION=false
